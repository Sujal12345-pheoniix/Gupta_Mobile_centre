# Database
DATABASE_URL=DUMMY_URL

# Redis
REDIS_URL=DUMMY-URL

# Application
APP_ENV=development
APP_PORT=3000

# Security
JWT_SECRET=replace-with-a-secure-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-secure-secret-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional: external services
# WHATSAPP_API_URL=
# WHATSAPP_API_KEY=
