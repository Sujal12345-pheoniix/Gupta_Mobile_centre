generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}
enum ProductStatus {
  ACTIVE
  ARCHIVED
}
enum TrackingMode {
  NONE
  BATCH
  SERIAL
}
enum StockMovementType {
  PURCHASE_RECEIPT
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  DAMAGE
  LOSS
  FOUND
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  COUNT_CORRECTION
}
enum SaleStatus {
  DRAFT
  CONFIRMED
  PAID
  COMPLETED
  CANCELLED
  PARTIALLY_RETURNED
  RETURNED
}
enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CREDIT
  MIXED
}
enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}
enum ReturnStatus {
  REQUESTED
  INSPECTING
  APPROVED
  REFUNDED
  REJECTED
}
enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  CONVERTED
  EXPIRED
  REJECTED
}
enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
enum ApprovalType {
  DISCOUNT
  STOCK_ADJUSTMENT
  RETURN
  EXPENSE
  PURCHASE
  PAYROLL
}
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}
enum PayrollStatus {
  DRAFT
  REVIEW
  APPROVED
  FINALIZED
}
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}
enum LedgerEntryType {
  DEBIT
  CREDIT
}
enum EmployeeStatus {
  ACTIVE
  INACTIVE
}
enum ShiftStatus {
  OPEN
  CLOSED
}
enum ReturnDisposition {
  RESTOCK
  DAMAGED
  QUARANTINE
  SUPPLIER_RETURN
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches   Branch[]
  users      User[]
  products   Product[]
  categories Category[]
  brands     Brand[]
  suppliers  Supplier[]
  customers  Customer[]
  employees  Employee[]
}

model Branch {
  id             String @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        Json?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  stockBalances StockBalance[]
  sales         Sale[]
  purchases     Purchase[]
  expenses      Expense[]
  shifts        Shift[]
  employees     Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String?
  phone          String?
  passwordHash   String
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee?
  roles        UserRole[]
  auditLogs    AuditLog[] @relation("AuditActor")
  sales        Sale[] @relation("SaleStaff")
  approvals    ApprovalRequest[] @relation("ApprovalActor")

  @@index([organizationId, status])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Category {
  id             String @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  organization Organization @relation(fields: [organizationId], references: [id])
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  @@unique([organizationId, name])
}

model Brand {
  id             String @id @default(cuid())
  organizationId String
  name           String
  organization Organization @relation(fields: [organizationId], references: [id])
  products Product[]
  @@unique([organizationId, name])
}

model Product {
  id             String @id @default(cuid())
  organizationId String
  categoryId     String?
  brandId        String?
  name           String
  description    String?
  status         ProductStatus @default(ACTIVE)
  organization Organization @relation(fields: [organizationId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  brand Brand? @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, status])
}

model ProductVariant {
  id              String @id @default(cuid())
  productId       String
  sku             String
  barcode         String?
  name            String?
  purchasePrice   Decimal @db.Decimal(12,2)
  sellingPrice    Decimal @db.Decimal(12,2)
  mrp             Decimal @db.Decimal(12,2)
  taxRate         Decimal @db.Decimal(5,2) @default(0)
  hsnCode         String?
  trackingMode    TrackingMode @default(NONE)
  reorderLevel    Decimal @db.Decimal(12,3) @default(0)
  minStock        Decimal @db.Decimal(12,3) @default(0)
  warrantyDays    Int?
  product         Product @relation(fields: [productId], references: [id])
  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  quotationItems  QuotationItem[]
  returnItems     ReturnItem[]
  @@unique([sku])
  @@unique([barcode])
  @@index([productId])
}

model StockBalance {
  id        String @id @default(cuid())
  branchId  String
  variantId String
  quantity  Decimal @db.Decimal(12,3) @default(0)
  reserved  Decimal @db.Decimal(12,3) @default(0)
  updatedAt DateTime @updatedAt
  branch Branch @relation(fields: [branchId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
  @@unique([branchId, variantId])
}

model StockMovement {
  id             String @id @default(cuid())
  branchId       String
  variantId      String
  type           StockMovementType
  quantity       Decimal @db.Decimal(12,3)
  unitCost       Decimal? @db.Decimal(12,2)
  referenceType  String?
  referenceId    String?
  reason         String?
  metadata       Json?
  createdById    String
  createdAt      DateTime @default(now())
  variant ProductVariant @relation(fields: [variantId], references: [id])
  @@index([branchId, variantId, createdAt])
  @@index([referenceType, referenceId])
}

model Supplier {
  id             String @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  gstin          String?
  address        Json?
  organization Organization @relation(fields: [organizationId], references: [id])
  purchases Purchase[]
  createdAt DateTime @default(now())
}

model Purchase {
  id             String @id @default(cuid())
  branchId       String
  supplierId     String
  invoiceNumber  String?
  status         PurchaseStatus @default(DRAFT)
  subtotal       Decimal @db.Decimal(12,2) @default(0)
  taxAmount      Decimal @db.Decimal(12,2) @default(0)
  total          Decimal @db.Decimal(12,2) @default(0)
  paidAmount     Decimal @db.Decimal(12,2) @default(0)
  dueAmount      Decimal @db.Decimal(12,2) @default(0)
  purchasedAt    DateTime?
  supplier Supplier @relation(fields: [supplierId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  items PurchaseItem[]
  createdAt DateTime @default(now())
}

model PurchaseItem {
  id         String @id @default(cuid())
  purchaseId String
  variantId  String
  quantity   Decimal @db.Decimal(12,3)
  unitCost   Decimal @db.Decimal(12,2)
  taxRate    Decimal @db.Decimal(5,2) @default(0)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Customer {
  id             String @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        Json?
  organization Organization @relation(fields: [organizationId], references: [id])
  sales Sale[]
  createdAt DateTime @default(now())
  @@index([organizationId, phone])
}

model Sale {
  id             String @id @default(cuid())
  branchId       String
  customerId     String?
  staffId        String
  invoiceNumber  String @unique
  status         SaleStatus @default(DRAFT)
  subtotal       Decimal @db.Decimal(12,2) @default(0)
  discountAmount Decimal @db.Decimal(12,2) @default(0)
  taxAmount      Decimal @db.Decimal(12,2) @default(0)
  total          Decimal @db.Decimal(12,2) @default(0)
  paidAmount     Decimal @db.Decimal(12,2) @default(0)
  createdAt      DateTime @default(now())
  branch Branch @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  staff User @relation("SaleStaff", fields: [staffId], references: [id])
  items SaleItem[]
  payments Payment[]
  returns Return[]
  @@index([branchId, createdAt])
}

model SaleItem {
  id          String @id @default(cuid())
  saleId      String
  variantId   String
  quantity    Decimal @db.Decimal(12,3)
  unitPrice   Decimal @db.Decimal(12,2)
  unitCost    Decimal @db.Decimal(12,2)
  discount    Decimal @db.Decimal(12,2) @default(0)
  taxAmount   Decimal @db.Decimal(12,2) @default(0)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id        String @id @default(cuid())
  saleId    String?
  purchaseId String?
  amount    Decimal @db.Decimal(12,2)
  method    PaymentMethod
  reference String?
  createdAt DateTime @default(now())
  sale Sale? @relation(fields: [saleId], references: [id])
}

model Return {
  id          String @id @default(cuid())
  saleId      String
  status      ReturnStatus @default(REQUESTED)
  refundAmount Decimal @db.Decimal(12,2) @default(0)
  reason      String
  createdAt   DateTime @default(now())
  sale Sale @relation(fields: [saleId], references: [id])
  items ReturnItem[]
}

model ReturnItem {
  id            String @id @default(cuid())
  returnId      String
  variantId     String
  quantity      Decimal @db.Decimal(12,3)
  disposition   ReturnDisposition
  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Quotation {
  id          String @id @default(cuid())
  branchId    String
  customerId  String?
  quoteNumber String @unique
  status      QuotationStatus @default(DRAFT)
  subtotal    Decimal @db.Decimal(12,2) @default(0)
  discount    Decimal @db.Decimal(12,2) @default(0)
  taxAmount   Decimal @db.Decimal(12,2) @default(0)
  total       Decimal @db.Decimal(12,2) @default(0)
  validUntil  DateTime?
  items       QuotationItem[]
  createdAt   DateTime @default(now())
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  variantId   String
  quantity    Decimal @db.Decimal(12,3)
  unitPrice   Decimal @db.Decimal(12,2)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Expense {
  id          String @id @default(cuid())
  branchId    String
  category    String
  description String?
  amount      Decimal @db.Decimal(12,2)
  status      ExpenseStatus @default(DRAFT)
  expenseDate DateTime
  createdAt   DateTime @default(now())
  branch Branch @relation(fields: [branchId], references: [id])
}

model Account {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  type        AccountType
  entries     LedgerEntry[]
}

model LedgerEntry {
  id        String @id @default(cuid())
  accountId String
  type      LedgerEntryType
  amount    Decimal @db.Decimal(12,2)
  referenceType String?
  referenceId String?
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id])
}

model Employee {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  userId         String? @unique
  employeeCode   String
  name           String
  phone          String?
  joiningDate    DateTime
  status         EmployeeStatus @default(ACTIVE)
  baseSalary     Decimal @db.Decimal(12,2) @default(0)
  commissionRate Decimal @db.Decimal(5,2) @default(0)
  organization Organization @relation(fields: [organizationId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  attendance Attendance[]
  payrollItems PayrollItem[]
  @@unique([organizationId, employeeCode])
}

model Attendance {
  id         String @id @default(cuid())
  employeeId String
  date       DateTime
  clockIn    DateTime?
  clockOut   DateTime?
  status     AttendanceStatus
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([employeeId, date])
}

model PayrollRun {
  id        String @id @default(cuid())
  periodStart DateTime
  periodEnd DateTime
  status PayrollStatus @default(DRAFT)
  totalAmount Decimal @db.Decimal(12,2) @default(0)
  items PayrollItem[]
  createdAt DateTime @default(now())
}

model PayrollItem {
  id          String @id @default(cuid())
  payrollRunId String
  employeeId  String
  baseSalary  Decimal @db.Decimal(12,2)
  commission  Decimal @db.Decimal(12,2) @default(0)
  overtime    Decimal @db.Decimal(12,2) @default(0)
  deductions  Decimal @db.Decimal(12,2) @default(0)
  advances    Decimal @db.Decimal(12,2) @default(0)
  netPay      Decimal @db.Decimal(12,2)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
}

model ApprovalRequest {
  id           String @id @default(cuid())
  type         ApprovalType
  status       ApprovalStatus @default(PENDING)
  requestedById String
  approvedById String?
  entityType   String
  entityId     String
  reason       String?
  createdAt    DateTime @default(now())
  requestedBy User @relation("ApprovalActor", fields: [requestedById], references: [id])
}

model Shift {
  id          String @id @default(cuid())
  branchId    String
  userId      String
  openingCash Decimal @db.Decimal(12,2)
  expectedCash Decimal? @db.Decimal(12,2)
  actualCash Decimal? @db.Decimal(12,2)
  difference  Decimal? @db.Decimal(12,2)
  status      ShiftStatus @default(OPEN)
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  branch Branch @relation(fields: [branchId], references: [id])
}

model AuditLog {
  id         String @id @default(cuid())
  organizationId String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor User? @relation("AuditActor", fields: [actorId], references: [id])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model OutboxEvent {
  id          String @id @default(cuid())
  eventType   String
  aggregateType String
  aggregateId String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
  @@index([processedAt, createdAt])
}
